# Copy to backend/.env. Defaults match deploy/docker-compose.yml.
STENO_DATABASE_URL=postgresql+psycopg://steno:steno@localhost:5434/steno
STENO_NEO4J_URI=bolt://localhost:7687
STENO_NEO4J_USER=neo4j
STENO_NEO4J_PASSWORD=steno-dev-password
# Extra rule pack folders, comma-separated: e.g. a clone of your organization's own packs repository
# STENO_RULE_PACK_DIRS=/path/to/org-rule-packs
# Every rule goes to the repository above, never to Steno's own rule-packs/ (D148). Misses in
# public libraries are listed for you to report instead of committed
# STENO_RULES_ORG_ONLY=true
# Opening pull requests on Bitbucket (the rule-pack-author skill)
# BITBUCKET_TOKEN=
# Your organization's own code, comma-separated (D146): Java packages, coordinates, or Python
# package prefixes. Calls into it that Steno hasn't read are "internal library" coverage items;
# the repository's own package roots count too, so this can stay empty
# STENO_INTERNAL_PREFIXES=com.acme,com.acme:*,acme_
